<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.InventoryApp" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Launch theme: purple splash with the white Nawano logo (matches the design's splash).
         MainActivity switches to Theme.InventoryApp via installSplashScreen(). -->
    <style name="Theme.InventoryApp.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/nawano_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.InventoryApp</item>
    </style>
</resources>
